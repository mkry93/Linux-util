#!/bin/bash

ytplay() {
    local input
    input=$(yad --entry --title="ytplay" --text="Enter input:") || return 1
    [[ -z "$input" ]] && { yad --title="Error" --text="	give input"; return 1; }

    eval "set -- $input"

    local query=""
    local num=1
    local -a mpv_args=()

    for arg in "$@"; do
        if [[ "$arg" =~ ^[0-9]+$ ]]; then
            num="$arg"
        elif [[ "$arg" == --* ]]; then
            mpv_args+=("$arg")
        else
            [[ -n "$query" ]] && query+=" "
            query+="$arg"
        fi
    done

    if [[ "$query" =~ ^https?:// ]]; then
        mpv "${mpv_args[@]}" "$query"
    else
        mpv "${mpv_args[@]}" "ytdl://ytsearch${num}:${query}"
    fi
}

ytplay
